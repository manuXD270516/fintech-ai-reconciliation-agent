# Synthetic, local-only development configuration for M0.
# These values are NOT secrets and must never be reused outside this local stack.
# Copy to .env (ignored by git): Copy-Item .env.example .env   |   cp .env.example .env

# Host port for the API; it is always bound to 127.0.0.1.
API_HOST_PORT=8000

# PostgreSQL bootstrap superuser: used only by the db-init job and the smoke tests.
POSTGRES_DB=recon_m0
POSTGRES_ADMIN_USER=recon_admin
POSTGRES_ADMIN_PASSWORD=dev-only-admin-password

# Restricted runtime role used by the API (no superuser, no CREATE, no CREATEROLE).
APP_DB_USER=recon_app
APP_DB_PASSWORD=dev-only-app-password

# NATS user shared by the API and the smoke tests.
NATS_APP_USER=recon_app
NATS_APP_PASSWORD=dev-only-nats-password

APP_LOG_LEVEL=INFO
# Global readiness deadline in seconds (0 < value <= 3).
APP_READY_TIMEOUT_SECONDS=2.5
